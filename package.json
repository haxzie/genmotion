{
  "name": "genmotion-monorepo",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:push": "pnpm --filter @genmotion/db db:push",
    "db:generate": "pnpm --filter @genmotion/db db:generate",
    "db:migrate": "pnpm --filter @genmotion/db db:migrate",
    "changeset": "changeset",
    "release": "pnpm --filter ./packages/shared --filter ./packages/three-engine --filter ./packages/cli --filter ./packages/create-genmotion run --if-present build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "tsup": "^8.5.1",
    "turbo": "^2.9.17",
    "typescript": "^5.9.3"
  }
}
