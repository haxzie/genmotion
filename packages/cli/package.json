{
  "name": "@genmotion/cli",
  "version": "0.2.2",
  "description": "Make videos with code and coding agents. Three.js scenes, a live studio, headless MP4 rendering, and an MCP server — one CLI.",
  "license": "Apache-2.0",
  "keywords": [
    "video",
    "motion-graphics",
    "threejs",
    "animation",
    "render",
    "mp4",
    "mcp",
    "ai-agents",
    "remotion-alternative",
    "hyperframes-alternative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haxzie/genmotion.git",
    "directory": "packages/cli"
  },
  "homepage": "https://genmotion.dev",
  "bugs": "https://github.com/haxzie/genmotion/issues",
  "type": "module",
  "bin": {
    "genmotion": "./bin/genmotion.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "esbuild": "0.28.0",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "playwright-core": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@genmotion/ai": "workspace:*",
    "@genmotion/config": "workspace:*",
    "@genmotion/project": "workspace:*",
    "@genmotion/render": "workspace:*",
    "@genmotion/shared": "workspace:*",
    "@genmotion/skills": "workspace:*",
    "@types/node": "^22",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
