{
  "name": "@genmotion/skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search": "./src/search.ts",
    "./catalog": "./generated/index.json",
    "./embeddings": "./generated/embeddings.json",
    "./node": "./src/catalog.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build-index": "tsx scripts/build-index.mjs",
