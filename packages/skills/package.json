  },
  "dependencies": {
    "@genmotion/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "@genmotion/config": "workspace:*",
    "@types/node": "^22",
    "ai": "^6.0.199",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
