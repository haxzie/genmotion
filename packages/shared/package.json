{
  "name": "@genmotion/shared",
  "version": "0.0.0",
  "description": "Shared types and frame math for GenMotion video projects.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haxzie/genmotion.git",
    "directory": "packages/shared"
  },
  "homepage": "https://genmotion.dev",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./render-token": "./src/render-token.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@genmotion/config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false
}
