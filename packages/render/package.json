{
  "name": "@genmotion/render",
  "version": "0.0.0",
  "private": true,
  "description": "Headless renderer for GenMotion projects (Playwright + ffmpeg). Bundled into the genmotion CLI.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:browser": "node scripts/build-browser.mjs dist/browser",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genmotion/compiler": "workspace:*",
    "@genmotion/project": "workspace:*",
    "@genmotion/shared": "workspace:*",
    "esbuild": "0.28.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@genmotion/config": "workspace:*",
    "@genmotion/player": "workspace:*",
    "@genmotion/three-engine": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
