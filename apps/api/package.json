{
  "name": "@genmotion/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.tsx-runtime.json --env-file=../../.env src/index.ts",
    "start": "tsx --tsconfig ../../tsconfig.tsx-runtime.json --env-file=../../.env src/index.ts",
    "start:docker": "tsx --tsconfig ../../tsconfig.tsx-runtime.json src/index.ts",
    "migrate": "tsx --tsconfig ../../tsconfig.tsx-runtime.json --env-file=../../.env src/migrate.ts",
    "migrate:docker": "tsx --tsconfig ../../tsconfig.tsx-runtime.json src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file=../../.env scripts/seed-scenes.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.82",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@genmotion/ai": "workspace:^",
    "@genmotion/db": "workspace:^",
    "@genmotion/shared": "workspace:*",
    "@genmotion/storage": "workspace:^",
    "@genmotion/templates": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.8.0",
    "ai": "^6.0.199",
    "better-auth": "^1.6.15",
    "dodopayments": "^2.43.0",
    "hono": "^4.12.25",
    "pg-boss": "^12.18.2",
    "posthog-node": "^5.48.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@genmotion/config": "workspace:*",
    "@types/node": "^22",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0",
    "standardwebhooks": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
