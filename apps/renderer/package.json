{
  "name": "@genmotion/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.tsx-runtime.json --env-file=../../.env src/index.ts",
    "start": "tsx --tsconfig ../../tsconfig.tsx-runtime.json --env-file=../../.env src/index.ts",
    "start:docker": "tsx --tsconfig ../../tsconfig.tsx-runtime.json src/index.ts",
    "render": "tsx --tsconfig ../../tsconfig.tsx-runtime.json src/render-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2b:build": "npx -y @e2b/cli template create genmotion-renderer --path ../.. --dockerfile apps/renderer/e2b/e2b.Dockerfile --cpu-count 2 --memory-mb 4096",
    "e2b:publish": "npx -y @e2b/cli template publish genmotion-renderer",
    "docker:sandbox": "docker build -f e2b/e2b.Dockerfile -t genmotion-render-sandbox ../.."
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.6.1",
    "@genmotion/compiler": "workspace:^",
    "@genmotion/db": "workspace:^",
    "@genmotion/motion": "workspace:^",
    "@genmotion/player": "workspace:^",
    "@genmotion/shared": "workspace:*",
    "@genmotion/storage": "workspace:^",
    "esbuild": "0.28.0",
    "ffmpeg-static": "^5.3.0",
    "pg-boss": "^12.18.2",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@genmotion/config": "workspace:*",
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
