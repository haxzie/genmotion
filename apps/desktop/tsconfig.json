{
  "extends": "@genmotion/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    // Mirrors the aliases in vite.config.ts. The exact keys win over the `@/*`
    // catch-all, so the shims shadow their web-app counterparts here too.
    "paths": {
      "next/link": ["./src/shims/next-link.tsx"],
      "next/dynamic": ["./src/shims/next-dynamic.ts"],
      "@/lib/analytics": ["./src/shims/analytics.ts"],
      "@/lib/billing": ["./src/shims/billing.ts"],
      "@/components/upgrade-modal": ["./src/shims/upgrade-modal.tsx"],
      "@/hooks/use-compiled-scenes": ["./src/shims/use-compiled-scenes.tsx"],
      "@/components/editor/*": ["./src/editor/components/*"],
      "@/components/composer": ["./src/editor/components/composer.tsx"],
      "@/hooks/use-assets": ["./src/editor/hooks/use-assets.ts"],
      "@/hooks/use-project": ["./src/editor/hooks/use-project.ts"],
      "@/hooks/use-waveform": ["./src/editor/hooks/use-waveform.ts"],
      "@/stores/editor-store": ["./src/editor/stores/editor-store.ts"],
      "@/*": ["../web/src/*"]
    }
  },
  "include": ["src", "electron", "vite.config.ts"]
}
