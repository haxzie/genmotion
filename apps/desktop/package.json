{
  "name": "@genmotion/desktop",
  "version": "0.0.2",
  "private": true,
  "description": "GenMotion desktop studio",
  "author": "GenMotion",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "package": "pnpm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "release:mac": "pnpm run build && electron-builder --mac --publish never",
    "verify:mac": "node scripts/verify-signing.mjs",
    "release:mac:sign-only": "pnpm run build && electron-builder --mac --config electron-builder.sign-only.yml"
  },
  "//": "Everything is compiled into dist by esbuild and Vite, so the packaged app has no runtime dependencies. Keeping this list empty is what stops electron-builder from trying to walk pnpm's symlinked node_modules.",
  "devDependencies": {
    "@ai-sdk/react": "^3.0.200",
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@codemirror/lang-javascript": "^6.2.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@genmotion/ai": "workspace:*",
    "@genmotion/compiler": "workspace:*",
    "@genmotion/config": "workspace:*",
    "@genmotion/motion": "workspace:*",
    "@genmotion/player": "workspace:*",
    "@genmotion/project": "workspace:*",
    "@genmotion/shared": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^5.1.0",
    "ai": "^6.0.199",
    "chokidar": "^4.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "esbuild": "0.28.0",
    "ffmpeg-static": "^5.3.0",
    "motion": "^12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
