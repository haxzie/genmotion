{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "test": {
      // Not a pure function of the source tree — the suite talks to a database.
      // Caching would replay a stale pass against a schema that has since moved.
      "cache": false
    },
    "lint": {}
  }
}
