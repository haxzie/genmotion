# Database
DATABASE_URL=postgres://genmotion:genmotion@localhost:5433/genmotion

# Auth — sign-in is magic link (email) + Google/GitHub OAuth only (no passwords).
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:4001

# OAuth providers. Each lights up only when both id+secret are set.
# Authorized redirect URI to register with each provider:
#   Google: ${BETTER_AUTH_URL}/api/auth/callback/google
#   GitHub: ${BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Magic-link email via Amazon SES (SESv2). Without EMAIL_FROM the API logs the
# link to the console instead of emailing (dev fallback). EMAIL_FROM must be a
# verified SES sender, e.g. "GenMotion <auth@yourdomain.com>".
EMAIL_FROM=
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# AI
# Chat/editor/compaction and the scene writer both run Moonshot Kimi via
# @ai-sdk/moonshotai. Two tiers: chat streams, so it runs the base model; the
# scene writer blocks the chat stream, so it runs the high-speed tier.
# Chat runs with thinking disabled — k2.6 reasons before emitting any visible
# text, which pushes time-to-first-token from ~1.9s to ~9s. Trade-off: the
# "Thought process" view in chat doesn't appear (see packages/ai/src/models.ts).
MOONSHOT_API_KEY=
# Optional overrides — leave unset to use the defaults shown.
# CHAT_MODEL=kimi-k2.6
# SCENE_MODEL=kimi-k2.7-code-highspeed
# Still used for vision/branding analysis (web tools).
ANTHROPIC_API_KEY=sk-ant-...

# Storage (MinIO in dev, Cloudflare R2 in prod)
# Objects are NOT served publicly — the API proxies reads at /api/projects/:id/files/*.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=genmotion
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=auto

# Sandbox (E2B) — powers the agent "workbench" tool
E2B_API_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4001
# Base URL the storage layer builds file-proxy URLs against (defaults to NEXT_PUBLIC_API_URL).
API_URL=http://localhost:4001
WEB_URL=http://localhost:4000

# Desktop app (apps/desktop) — which deployment it signs in against. Only read
# by the Electron main process, and only needed in dev; a packaged build
# defaults to the production API and web app.
GM_CLOUD_API_URL=http://localhost:4001
GM_CLOUD_WEB_URL=http://localhost:4000

# Desktop code signing + notarization (macOS release builds only).
#
# Signing uses the "Developer ID Application" certificate in the login keychain
# — nothing to configure here, and `pnpm package` opts out entirely so local
# builds stay fast. These three are only for `pnpm release:mac`.
#
# They are App Store Connect API key credentials, from App Store Connect →
# Users and Access → Integrations → Keys. APPLE_API_KEY is a *path* to the .p8
# private key; never commit the file or paste its contents here. The issuer id
# is the UUID shown once at the top of that same Keys page.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Desktop releases. The marketing site's Download button reads the newest
# GitHub release through the API, so no version is ever written into the web
# app. No token: the repo is public, so releases are readable anonymously.
GITHUB_RELEASE_REPO=haxzie/genmotion

# Where the mirrored DMG lives — the release workflow publishes the file and a
# latest.json here, and the download endpoint prefers it over GitHub because it
# is dramatically faster. Unset it to send every download to GitHub instead.
RELEASE_MIRROR_URL=https://assets.genmotion.dev/desktop

# Analytics (PostHog) — optional; analytics is a no-op until the key is set.
# Project API key from PostHog → Project Settings.
NEXT_PUBLIC_POSTHOG_KEY=
# Host defaults to US cloud (https://us.i.posthog.com) — only set this to
# override (e.g. https://eu.i.posthog.com for EU, or a reverse-proxy path).
# NEXT_PUBLIC_POSTHOG_HOST=

# Analytics (Google Analytics 4) — optional; gtag.js is not loaded until this
# is set. Measurement ID from GA4 → Admin → Data streams → Web (G-XXXXXXXXXX).
# Pageviews on client-side navigations rely on GA4 enhanced measurement's
# "page changes based on browser history events" (on by default).
NEXT_PUBLIC_GA_ID=

# Web research (optional — agent brand/style tools)
FIRECRAWL_API_KEY=

# TTS voiceovers (OpenAI gpt-4o-mini-tts) — the retired hosted studio's tool.
OPENAI_API_KEY=

# ── Chat plugins ────────────────────────────────────────────────────────────
# The `+` menu in the desktop composer. These are the only features that cost
# us money per use — everything else runs on the user's own machine with their
# own agent — so they are gated on a PAID subscription, not merely an unexpired
# trial, and every call is logged to plugin_calls.
#
# Voiceover (ElevenLabs). Without a key the plugin answers 503, which reads to
# the user as "not available here" rather than as a bad request of theirs.
ELEVENLABS_API_KEY=
# Optional overrides — leave unset to use the defaults shown.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Rachel, from the default voice library, when the agent names no voice.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
#
# Image generation (Google Gemini "Nano Banana"). The same key backs the
# retired hosted studio's generateImage tool.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Billing (Dodo Payments) ─────────────────────────────────────────────────
# Optional: billing is inert until these are set — checkout returns 503 and the
# webhook receiver refuses deliveries (503, so the provider keeps retrying
# until the key is set) rather than trusting unverified payloads.
#
# Pricing is per person: Pro is the base product and carries one seat, and
# every teammate past the first is a quantity on the seat add-on at the same
# price. The add-on must be attached to the product in Dodo, or checkout
# rejects the cart. See docs.dodopayments.com/features/seat-based-billing.
#
# Product and add-on ids differ between test_mode and live_mode. For local
# development, `pnpm --filter @genmotion/api dodo:setup --url <tunnel>` creates
# the add-on, attaches it, registers the webhook endpoint and prints the values
# to paste below.
DODOPAYMENT_API_KEY=
DODOPAYMENT_PRO_PRODUCT_ID=
DODOPAYMENT_SEAT_ADDON_ID=
# Standard Webhooks signing secret (whsec_…) of the endpoint
# POST {API_URL}/api/webhooks/dodo registered in the Dodo dashboard.
DODOPAYMENT_WEBHOOK_KEY=
# test_mode (default) or live_mode.
DODOPAYMENT_ENVIRONMENT=test_mode

# ── Free video generators (/tools) ──────────────────────────────────────────
# Read by the WEB app, not the API — these back the public, unauthenticated
# source endpoints under /api/tools and are the only secrets apps/web needs.
# Both are optional: without them the affected tool degrades rather than
# breaking the site.
#
# Optional, and only affects rate limits: the star count tool reads the public
# /repos/{owner}/{repo} endpoint, which works unauthenticated at 60 requests per
# hour per IP. Set a token (classic or fine-grained) in production to lift that.
#
# Note for anyone tempted to build a star-history or stargazer-avatar feature:
# GitHub does not expose *who* starred a repository. /stargazers answers 404 and
# the GraphQL stargazers connection returns zero edges, for every repo, with any
# token. Star counts are available; star identities and timestamps are not.
GITHUB_TOKEN=
# YouTube Data API v3 key (Google Cloud console → APIs & Services). Free tier is
# 10,000 units/day; a channel lookup costs 1. Without it the YouTube generator
# returns 503 and the other three are unaffected.
YOUTUBE_API_KEY=

# Server-side analytics (optional). The API emits only lifecycle facts the
# browser cannot know for certain — signup, principally: magic link and OAuth
# both land on the same callback, so the client can't tell a new account from a
# returning login, while the user-created database hook fires exactly once.
# Unset means the API emits nothing. Use the same project key as
# NEXT_PUBLIC_POSTHOG_KEY so browser and server events land on one person.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
